@page "/"
@using CharacterCreator.Core
@inject ICharacterRuleset Ruleset
@inject CharacterBuildService BuildService
@rendermode InteractiveServer

<PageTitle>Tvorba postavy | Jeskyně a draci</PageTitle>

<div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@_screenReaderAnnouncement</div>

<div class="app-shell">
	<header class="masthead">
		<a class="brand" href="/" aria-label="Tvorba postavy, úvodní stránka">
			<span class="brand-mark" aria-hidden="true">A</span>
			<span>Tvorba postavy</span>
		</a>
		<span class="ruleset-label"><span class="status-dot"></span> Jeskyně a draci <span class="edition">JaD · v1</span></span>
	</header>

	<main class="workbench">
		<section class="page-intro">
			<p class="eyebrow">Kronika začíná</p>
			<h1>Zrození<br /><span>postavy</span></h1>
			<p class="intro-copy">Vyber původ a povolání. Potom hoď kostkami a rozděl své vlastnosti.</p>
		</section>

		<div class="creator-grid">
			<section class="setup-panel" aria-labelledby="identity-heading">
				<div class="section-heading">
					<span class="step-number">01</span>
					<div>
						<p class="eyebrow">Nejdřív kořeny</p>
						<h2 id="identity-heading">Kdo se vydává na cestu?</h2>
					</div>
				</div>

				<label class="field-label" for="character-name">Jméno postavy</label>
				<input id="character-name" class="text-field" @bind="_name" @bind:event="oninput" @bind:after="ClearBuild" maxlength="48" placeholder="Například Mira" autocomplete="off" />

				<section class="selection-group" aria-labelledby="ancestry-heading">
					<h3 id="ancestry-heading" class="field-label">Rasa</h3>
					<p class="field-hint selection-hint">Rozbal rasu, přečti si o ní a potvrď svůj výběr.</p>
					<div class="selection-accordion">
						@foreach (var ancestry in Ruleset.Ancestries)
						{
							var selected = ancestry.Id == _ancestryId;
							var info = AncestryInfo(ancestry.Id);
							<details @key="ancestry.Id" name="ancestry" class="selection-entry @(selected ? "is-selected" : null)">
								<summary>
									<span>@AncestryName(ancestry.Id)</span>
									@if (selected)
									{
										<span class="selection-badge">@(SelectedSubraceName ?? "Vybráno")</span>
									}
								</summary>
								<div class="selection-content">
									<p>@info.Description</p>
									<p class="selection-bonuses"><strong>Bonusy vlastností:</strong> @BonusDescription(ancestry.Bonuses, ancestry.ChoiceRule)</p>
									@if (ancestry.Subraces.Count > 0)
									{
										<p class="field-hint">K základnímu bonusu se přičítá bonus zvoleného rodu:</p>
										<ul class="subrace-bonuses">
											@foreach (var subrace in ancestry.Subraces)
											{
												<li><strong>@SubraceName(subrace.Id):</strong> @BonusDescription(subrace.Bonuses, subrace.ChoiceRule)</li>
											}
										</ul>
									}
									<p class="rulebook-source">JaD 1.3.3 · Rasy, s. @info.Page</p>
									@if (ancestry.Subraces.Count > 0)
									{
										<div class="subrace-buttons" aria-label="Podoba rodu">
											@foreach (var subrace in ancestry.Subraces)
											{
												<button type="button" class="selection-button" aria-pressed="@(selected && _subraceId == subrace.Id ? "true" : "false")" @onclick="() => SelectAncestry(ancestry.Id, subrace.Id)">
													@SubraceName(subrace.Id)
												</button>
											}
										</div>
									}
									else
									{
										<button type="button" class="selection-button" aria-pressed="@(selected ? "true" : "false")" aria-label="@($"Zvolit rasu: {AncestryName(ancestry.Id)}")" @onclick="() => SelectAncestry(ancestry.Id)">
											@(selected ? "Vybraná rasa" : "Zvolit rasu")
										</button>
									}
								</div>
							</details>
						}
					</div>
				</section>

				@if (ChoiceRule is { } choiceRule)
				{
					<div class="bonus-choice-group">
						<p class="field-label">Vyber vlastnosti pro rasový bonus</p>
						<div class="field-row">
							<div class="field-group">
								<label class="visually-hidden" for="bonus-one">První vlastnost</label>
								<select id="bonus-one" class="select-field" @bind="_bonusChoiceOne" @bind:after="ClearBuild">
									<option value="">Vyber vlastnost</option>
									@foreach (var ability in choiceRule.AllowedAbilities)
									{
										<option value="@ability">@AbilityName(ability)</option>
									}
								</select>
							</div>
							@if (choiceRule.Count > 1)
							{
								<div class="field-group">
									<label class="visually-hidden" for="bonus-two">Druhá vlastnost</label>
									<select id="bonus-two" class="select-field" @bind="_bonusChoiceTwo" @bind:after="ClearBuild">
										<option value="">Vyber vlastnost</option>
										@foreach (var ability in choiceRule.AllowedAbilities.Where(ability => ability != _bonusChoiceOne))
										{
											<option value="@ability">@AbilityName(ability)</option>
										}
									</select>
								</div>
							}
						</div>
						<p class="field-hint">Každý bonus musí připadnout na jinou vlastnost.</p>
					</div>
				}

				<section class="selection-group" aria-labelledby="class-heading">
					<h3 id="class-heading" class="field-label">Povolání</h3>
					<p class="field-hint selection-hint">Rozbal povolání a vyber, jakou cestou se vydáš.</p>
					<div class="selection-accordion">
						@foreach (var characterClass in Ruleset.Classes)
						{
							var selected = characterClass.Id == _classId;
							var info = ClassInfo(characterClass.Id);
							<details @key="characterClass.Id" name="character-class" class="selection-entry @(selected ? "is-selected" : null)">
								<summary>
									<span>@ClassName(characterClass.Id)</span>
									@if (selected)
									{
										<span class="selection-badge">Vybráno</span>
									}
								</summary>
								<div class="selection-content">
									<p>@info.Description</p>
									<p class="rulebook-source">JaD 1.3.3 · Povolání, s. @info.Page</p>
									<button type="button" class="selection-button" aria-pressed="@(selected ? "true" : "false")" aria-label="@($"Zvolit povolání: {ClassName(characterClass.Id)}")" @onclick="() => SelectClass(characterClass.Id)">
										@(selected ? "Vybrané povolání" : "Zvolit povolání")
									</button>
								</div>
							</details>
						}
					</div>
				</section>

				@if (HasValidSelections)
				{
					<div class="bonus-preview" aria-live="polite">
						<span class="preview-label">Rasové bonusy</span>
						@foreach (var bonus in CurrentBonuses.OrderBy(pair => pair.Key))
						{
							<span class="bonus-token">@AbilityShortName(bonus.Key) <b>+@bonus.Value</b></span>
						}
					</div>
				}
			</section>

			<section class="roll-panel" aria-labelledby="roll-heading">
				<div class="section-heading">
					<span class="step-number">02</span>
					<div>
						<p class="eyebrow">Osud v kostkách</p>
						<h2 id="roll-heading">Rozdej vlastnosti</h2>
					</div>
				</div>
				<p class="section-copy">Každý hod: 4k6, nejnižší kostka se nepočítá. Šest výsledků pak rozděl mezi vlastnosti.</p>

				<button class="primary-button" type="button" @onclick="RollScores" disabled="@(!CanRoll)">
					<span aria-hidden="true">✦</span> Hodit šestkrát
				</button>

				@if (_rolls.Count > 0)
				{
					<div class="assignment-heading">
						<span class="mini-rule"></span>
						<p>Přiřaď každý hod právě jednou</p>
					</div>
					<p id="assignment-help" class="field-hint">Přetáhni hod zprava na vlastnost vlevo, nebo klikni na hod a potom na vlastnost. Obsazené hody se vymění. Hod můžeš vrátit do zásoby.</p>
					<div class="score-workspace" aria-describedby="assignment-help">
						<div class="assignment-list" aria-label="Vlastnosti">
							@foreach (var ability in Enum.GetValues<Ability>())
							{
								var roll = AssignedRoll(ability);
								<div class="assignment-row">
									<button id="score-@ability" type="button" class="ability-target @(_selectedRollId.HasValue || _draggedRollId.HasValue ? "is-ready" : null)"
										draggable="@(roll is not null ? "true" : "false")"
										aria-label="@($"{AbilityName(ability)}: {(roll is null ? "nepřiřazeno" : $"hod {roll.Id + 1}, {roll.Total}")}")"
										aria-pressed="@(_selectedRollId.HasValue && _selectedRollId == roll?.Id ? "true" : "false")"
										@onclick="() => ActivateAbility(ability)"
										@ondragstart="() => StartDrag(roll?.Id)" @ondragend="EndDrag"
										@ondragover:preventDefault @ondrop:preventDefault @ondrop="() => DropOnAbility(ability)">
										<span class="ability-name">@AbilityName(ability)</span>
										<span class="assigned-total">@(roll is null ? "—" : roll.Total.ToString())</span>
									</button>
									@if (roll is not null)
									{
										<button type="button" class="remove-score" aria-label="@($"Vrátit hod z vlastnosti {AbilityName(ability)}")" @onclick="() => ReturnRoll(roll.Id)">×</button>
									}
								</div>
							}
						</div>
						<div class="score-pool" aria-label="Zásoba hodů" @ondragover:preventDefault @ondrop:preventDefault @ondrop="DropOnPool">
							<p class="field-label">Hody k přiřazení</p>
							@foreach (var roll in _rolls.Where(roll => !_assignments.Values.Contains(roll.Id)))
							{
								<button @key="roll.Id" type="button" class="roll-result @(_selectedRollId == roll.Id ? "is-active" : null)" data-roll-id="@roll.Id"
									draggable="true" aria-label="@($"Hod {roll.Id + 1}: {roll.Total}")" aria-pressed="@(_selectedRollId == roll.Id ? "true" : "false")"
									@onclick="() => SelectRoll(roll.Id)" @ondragstart="() => StartDrag(roll.Id)" @ondragend="EndDrag">
									<span class="roll-number">Hod @(roll.Id + 1)</span>
									<span class="dice-row" aria-label="Kostky: @string.Join(", ", roll.Dice)">
										@for (var dieIndex = 0; dieIndex < roll.Dice.Count; dieIndex++)
										{
											<span class="die @(IsDroppedDie(roll, dieIndex) ? "die-dropped" : null)">@roll.Dice[dieIndex]</span>
										}
									</span>
									<span class="roll-total">@roll.Total</span>
								</button>
							}
							@if (_assignments.Values.All(value => value.HasValue))
							{
								<p class="field-hint">Všechny hody jsou přiřazeny.</p>
							}
							@if (_selectedRollId is { } selectedRollId)
							{
								<button type="button" class="text-button" @onclick="() => ReturnRoll(selectedRollId)">Vrátit vybraný hod</button>
								<button type="button" class="text-button" @onclick="CancelSelection">Zrušit výběr</button>
							}
						</div>
					</div>

					@if (CanBuild)
					{
						<button class="finish-button" type="button" @onclick="BuildCharacter">Dokončit postavu <span aria-hidden="true">→</span></button>
					}
				}
				else
				{
					<div class="roll-placeholder">
						<span class="placeholder-mark" aria-hidden="true">✳</span>
						<p>Tvoje hody se objeví tady.</p>
					</div>
				}
			</section>
		</div>

		@if (_sheet is not null)
		{
			<section class="character-sheet" aria-labelledby="sheet-heading" aria-live="polite" tabindex="-1" @ref="_sheetElement">
				<div class="sheet-title">
					<div>
						<p class="eyebrow">Postava připravena</p>
						<h2 id="sheet-heading">@_sheet.Name</h2>
						<p class="sheet-subtitle">@AncestryName(_sheet.AncestryId) · @SelectedSubraceName · @SelectedClassName</p>
					</div>
					<span class="sheet-seal">JaD</span>
				</div>
				<div class="score-grid">
					@foreach (var ability in Enum.GetValues<Ability>())
					{
						var bonus = _sheet.Bonuses.GetValueOrDefault(ability);
						<article class="score-card">
							<span class="score-label">@AbilityName(ability)</span>
							<strong>@_sheet.Scores[ability]</strong>
							<span class="score-modifier">Oprava @_sheet.GetAbilityModifier(ability).ToString("+0;-0;0")</span>
							<span class="score-detail">základ @_sheet.BaseScores[ability] @if (bonus > 0) { <span>· +@bonus</span> }</span>
						</article>
					}
				</div>
				<button class="text-button" type="button" @onclick="() => _sheet = null">Upravit přiřazení</button>
			</section>
		}
	</main>

	<footer class="page-footer">
		<span>Tvorba postavy</span>
		<span>Pravidla JaD · <span class="footer-mark">hod kostkou, vlastní příběh</span></span>
	</footer>
</div>

@code {
	private string _name = string.Empty;
	private string _ancestryId = string.Empty;
	private string? _subraceId;
	private string _classId = string.Empty;
	private Ability? _bonusChoiceOne;
	private Ability? _bonusChoiceTwo;
	private IReadOnlyList<AbilityRoll> _rolls = [];
	private int? _selectedRollId;
	private int? _draggedRollId;
	private readonly Dictionary<Ability, int?> _assignments = Enum.GetValues<Ability>()
		.ToDictionary(ability => ability, _ => (int?)null);
	private CharacterSheet? _sheet;
	private ElementReference _sheetElement;
	private bool _focusSheet;
	private string _screenReaderAnnouncement = string.Empty;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (_focusSheet && _sheet is not null)
		{
			_focusSheet = false;
			await _sheetElement.FocusAsync();
		}
	}

	private AncestryDefinition? SelectedAncestry => Ruleset.Ancestries.FirstOrDefault(ancestry => ancestry.Id == _ancestryId);

	private SubraceDefinition? SelectedSubrace => SelectedAncestry?.Subraces.FirstOrDefault(subrace => subrace.Id == _subraceId);

	private string? SelectedSubraceName => SelectedSubrace is { } subrace ? SubraceName(subrace.Id) : null;

	private string? SelectedClassName => Ruleset.Classes.Any(item => item.Id == _classId) ? ClassName(_classId) : null;

	private AbilityChoiceRule? ChoiceRule => SelectedSubrace?.ChoiceRule ?? SelectedAncestry?.ChoiceRule;

	private IReadOnlyList<Ability> BonusChoices => new[] { _bonusChoiceOne, _bonusChoiceTwo }
		.Where(choice => choice.HasValue)
		.Select(choice => choice!.Value)
		.ToArray();

	private bool HasValidSelections
	{
		get
		{
			if (SelectedAncestry is null || string.IsNullOrEmpty(_classId) ||
				(SelectedAncestry.Subraces.Count > 0 && SelectedSubrace is null))
			{
				return false;
			}

			try
			{
				_ = Ruleset.ResolveAbilityBonuses(_ancestryId, _subraceId, BonusChoices);
				return true;
			}
			catch (ArgumentException)
			{
				return false;
			}
		}
	}

	private bool CanRoll => !string.IsNullOrWhiteSpace(_name) && HasValidSelections;

	private IReadOnlyDictionary<Ability, int> CurrentBonuses => HasValidSelections
		? Ruleset.ResolveAbilityBonuses(_ancestryId, _subraceId, BonusChoices)
		: new Dictionary<Ability, int>();

	private bool CanBuild => CanRoll && _rolls.Count == Enum.GetValues<Ability>().Length &&
		_assignments.Values.All(value => value.HasValue) &&
		_assignments.Values.Distinct().Count() == _assignments.Count;

	private void SelectAncestry(string id, string? subraceId = null)
	{
		if (_ancestryId == id && _subraceId == subraceId)
		{
			return;
		}

		_ancestryId = id;
		_subraceId = subraceId;
		_bonusChoiceOne = null;
		_bonusChoiceTwo = null;
		ClearRolls();
		_screenReaderAnnouncement = $"Vybraná rasa: {AncestryName(id)}{(subraceId is null ? "" : $", {SubraceName(subraceId)}")}.";
	}

	private void SelectClass(string id)
	{
		if (_classId == id)
		{
			return;
		}

		_classId = id;
		ClearBuild();
		_screenReaderAnnouncement = $"Vybrané povolání: {ClassName(id)}.";
	}

	private void ClearBuild() => _sheet = null;

	private void ClearRolls()
	{
		_rolls = [];
		_selectedRollId = null;
		_draggedRollId = null;
		foreach (var ability in Enum.GetValues<Ability>())
		{
			_assignments[ability] = null;
		}

		_sheet = null;
	}

	private void RollScores()
	{
		if (!CanRoll)
		{
			return;
		}

		_rolls = AbilityScoreRoller.Roll(Ruleset.AbilityScoreRule);
		ClearRollsAssignments();
		var results = string.Join(", ", _rolls.Select((roll, index) => $"hod {index + 1}: {roll.Total}"));
		_screenReaderAnnouncement = $"Hody jsou připravené. {results}. Nyní přiřaď každý hod právě jednou.";
	}

	private void OnAssignmentChanged()
	{
		ClearBuild();
		var assignedCount = _assignments.Values
			.Where(value => value.HasValue)
			.Select(value => value!.Value)
			.Distinct()
			.Count();

		_screenReaderAnnouncement = assignedCount == _assignments.Count
			? "Všechny hody jsou přiřazeny. Můžeš dokončit postavu."
			: $"Přiřazeno {assignedCount} z {_assignments.Count} hodů.";
	}

	private void ClearRollsAssignments()
	{
		_selectedRollId = null;
		_draggedRollId = null;
		foreach (var ability in Enum.GetValues<Ability>())
		{
			_assignments[ability] = null;
		}

		_sheet = null;
	}

	private bool IsDroppedDie(AbilityRoll roll, int dieIndex) =>
		dieIndex == roll.Dice.ToList().IndexOf(roll.Dice.Min());

	private AbilityRoll? AssignedRoll(Ability ability) =>
		_rolls.FirstOrDefault(roll => roll.Id == _assignments[ability]);

	private void SelectRoll(int rollId)
	{
		_selectedRollId = _selectedRollId == rollId ? null : rollId;
		_screenReaderAnnouncement = _selectedRollId.HasValue
			? $"Vybrán hod {rollId + 1}. Vyber vlastnost, které ho přiřadíš."
			: "Výběr hodu zrušen.";
	}

	private void CancelSelection()
	{
		_selectedRollId = null;
		_screenReaderAnnouncement = "Výběr hodu zrušen.";
	}

	private void StartDrag(int? rollId) => _draggedRollId = rollId;

	private void EndDrag() => _draggedRollId = null;

	private void ActivateAbility(Ability ability)
	{
		if (_selectedRollId is { } rollId)
		{
			AssignRoll(ability, rollId);
		}
		else if (_assignments[ability] is { } assignedId)
		{
			SelectRoll(assignedId);
		}
		else
		{
			_screenReaderAnnouncement = "Nejdřív vyber hod ze zásoby vpravo.";
		}
	}

	private void DropOnAbility(Ability ability)
	{
		if (_draggedRollId is { } rollId)
		{
			AssignRoll(ability, rollId);
		}
	}

	private void AssignRoll(Ability ability, int rollId)
	{
		var previousRollId = _assignments[ability];
		if (previousRollId == rollId)
		{
			_draggedRollId = null;
			CancelSelection();
			return;
		}

		foreach (var source in Enum.GetValues<Ability>())
		{
			if (_assignments[source] == rollId)
			{
				_assignments[source] = previousRollId;
				break;
			}
		}

		_assignments[ability] = rollId;
		_selectedRollId = null;
		_draggedRollId = null;
		OnAssignmentChanged();
	}

	private void ReturnRoll(int rollId)
	{
		foreach (var ability in Enum.GetValues<Ability>())
		{
			if (_assignments[ability] == rollId)
			{
				_assignments[ability] = null;
			}
		}

		_selectedRollId = null;
		_draggedRollId = null;
		OnAssignmentChanged();
	}

	private void DropOnPool()
	{
		if (_draggedRollId is { } rollId)
		{
			ReturnRoll(rollId);
		}
	}

	private void BuildCharacter()
	{
		if (!CanBuild)
		{
			return;
		}

		_sheet = BuildService.Build(new CharacterBuildRequest(
			_name,
			_ancestryId,
			_subraceId,
			_classId,
			_rolls,
			_assignments.ToDictionary(assignment => assignment.Key, assignment => assignment.Value!.Value),
			BonusChoices));
		_focusSheet = true;
		_screenReaderAnnouncement = "Postava je připravena. Přehled obsahuje konečné vlastnosti s rasovými bonusy a jejich opravy.";
	}

	private static string AbilityName(Ability ability) => ability switch
	{
		Ability.Strength => "Síla",
		Ability.Dexterity => "Obratnost",
		Ability.Constitution => "Odolnost",
		Ability.Intelligence => "Inteligence",
		Ability.Wisdom => "Moudrost",
		Ability.Charisma => "Charisma",
		_ => ability.ToString()
	};

	private static string AbilityShortName(Ability ability) => ability switch
	{
		Ability.Strength => "SÍL",
		Ability.Dexterity => "OBR",
		Ability.Constitution => "ODO",
		Ability.Intelligence => "INT",
		Ability.Wisdom => "MOU",
		Ability.Charisma => "CHA",
		_ => ability.ToString()
	};

	private static string BonusDescription(IReadOnlyDictionary<Ability, int> bonuses, AbilityChoiceRule? choiceRule)
	{
		var parts = bonuses.OrderBy(pair => pair.Key)
			.Select(pair => $"{AbilityName(pair.Key)} +{pair.Value}")
			.ToList();

		if (choiceRule is not null)
		{
			parts.Add(choiceRule.Count > 1
				? $"+1 ke každé ze {choiceRule.Count} různých vlastností podle volby"
				: $"+1 k jedné z vlastností: {string.Join(" nebo ", choiceRule.AllowedAbilities.Select(AbilityName))}");
		}

		return string.Join("; ", parts);
	}

	private static (string Description, string Page) AncestryInfo(string id) => id switch
	{
		"human" => ("Všestranní lidé se mohou vydat cestou kteréhokoli povolání. Jejich síla spočívá ve společnosti, vlastních ambicích a schopnosti překonat své slabosti.", "58–61"),
		"elf" => ("Elfové mají vílí kořeny, silné emoce a blízký vztah k prostředí, z něhož pocházejí. Jsou obratní, nadaní pro magii a místo běžného spánku prožívají své vzpomínky v transu.", "63–69"),
		"dwarf" => ("Houževnatí trpaslíci jsou spjati se zemí, svým klanem a řemeslem. Cení si trvalých výtvorů a souladu slov s činy; jejich rod určuje další nadání i mystický pohled na svět.", "71–78"),
		"halfling" => ("Malí a obratní půlčíci si cení dobrého jídla a společnosti. Na dobrodružstvích jim pomáhá štěstí, odvaha a schopnost nenápadně se pohybovat mezi většími tvory.", "79–81"),
		"half-orc" => ("Půlorkové spojují lidské ambice s orčí silou a vytrvalostí. Bývají temperamentní a hrdí; v nebezpečí se mohou opřít o mimořádnou houževnatost a prudké útoky.", "82–84"),
		"gnome" => ("Zvídaví gnómové mají spoustu energie a talent pro techniku i řemesla. Rádi zkoumají a vylepšují svět kolem sebe, staví mechanické hříčky a umějí odolávat magii působící na mysl.", "85–88"),
		"dragonborn" => ("Drakorození nesou vzhled i dědictví dračích předků: šupiny, mohutnou postavu a ničivý dech. Jejich život často určují čest, povinnost a hrdost; dračí původ ovlivňuje dech i odolnost.", "89–91"),
		"tiefling" => ("Rohy a ocas připomínají temný původ tieflingů, nikoli nutně jejich vlastní povahu. Jsou působiví a duševně nadaní; pekelné dědictví jim dává vrozenou magii a odolnost vůči ohni.", "92–94"),
		_ => throw new ArgumentOutOfRangeException(nameof(id), id, "Missing ancestry description.")
	};

	private static (string Description, string Page) ClassInfo(string id) => id switch
	{
		"alchemist" => ("Alchymista zkoumá přírodu i magii a mění své poznatky v lektvary, nástroje a magické vynálezy. Družině pomáhá důmyslnou výbavou a praktickým využitím svých znalostí.", "98"),
		"barbarian" => ("Barbar se v boji opírá o instinkty, zuřivost a mimořádnou výdrž. Hodí se do první linie i do divočiny a nemusí pocházet jen z kmenové společnosti.", "110"),
		"bard" => ("Bard propojuje umění s magií: slovy, hudbou či výjevy inspiruje spojence a ovlivňuje ostatní. Je všestranný dobrodruh, který vedle kouzel využívá společenské nadání a pestré dovednosti.", "117"),
		"fighter" => ("Bojovník si z boje udělal řemeslo a ovládá zbraně, výstroj i vytříbené techniky. Na bojišti spoléhá na výcvik, rychlý úsudek a schopnost zachovat přehled i pod tlakem.", "123"),
		"sorcerer" => ("Čaroděj má magii vrozenou díky neobvyklému původu či nadpřirozenému dědictví. Jeho kouzla nejsou výsledkem studia, ale přirozeným projevem moci, která je součástí jeho bytosti.", "135"),
		"warlock" => ("Černokněžník získává kouzla a zvláštní schopnosti prostřednictvím paktu s mocným nadpřirozeným patronem. Za propůjčenou moc přijímá závazky a vládne magií odlišnou od ostatních sesilatelů.", "143"),
		"druid" => ("Druid rozumí přírodní magii a cyklům života. Může chránit mystická místa, léčit a sesílat přírodní kouzla; své spojení se zvířaty využívá také k proměně do jejich podoby.", "155"),
		"cleric" => ("Klerik je vyvolený služebník božstva, který svou vírou získává moc konat zázraky. Léčí, čelí nemrtvým a brání posvátné věci nejen kouzly, ale i slovem a zbraní.", "162"),
		"wizard" => ("Kouzelník získává magickou moc studiem, pokusy a porozuměním silám světa. Nabízí široký výběr kouzel, která shromažďuje v grimoáru; jeho všestrannost však vyžaduje přípravu.", "169"),
		"monster-hunter" => ("Lovec netvorů obrací spoutanou temnotu proti příšerám a nadpřirozenému zlu. Kombinuje bojový výcvik a znalosti nepřátel se zakletími a nebezpečnými rituály.", "176"),
		"rogue" => ("Tulák spoléhá na důvtip, pohotovost a pečlivě vypilované dovednosti. Poradí si s překážkami, nenápadným pronikáním i přesnými útoky; nemusí přitom být zločincem.", "188"),
		_ => throw new ArgumentOutOfRangeException(nameof(id), id, "Missing class description.")
	};

